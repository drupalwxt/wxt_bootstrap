{#
/**
 * @file
 * Default theme implementation of a datetime form wrapper.
 *
 * Available variables:
 * - content: The form element to be output, usually a datelist, or datetime.
 * - title: The title of the form element.
 * - title_attributes: HTML attributes for the title wrapper.
 * - description: Description text for the form element.
 * - required: An indicator for whether the associated form element is required.
 *
 * @ingroup templates
 *
 * @see template_preprocess_datetime_wrapper()
 */
#}
{%
  set title_classes = [
    'control-label',
    required ? 'form-required required',
  ]
%}
{# Prefer real input id, otherwise fallback. #}
{% set for_id = element.date['#id'] ?? null
%}
{% if title %}
  {% if for_id and not title_attributes.hasAttribute('for') %}
    <label{{ title_attributes.addClass(title_classes).setAttribute('for', for_id) }}>
      <span class="field-name">{{ title }}</span>
      {% if required %}
         <strong class="required" aria-hidden="true">({{ 'required'|t }})</strong>
      {% endif %}
    </label>
  {% else %}
    <label{{ title_attributes.addClass(title_classes) }}>
      <span class="field-name">{{ title }}</span>
      {% if required %}
        <strong class="required" aria-hidden="true">({{ 'required'|t }})</strong>
      {% endif %}
    </label>
  {% endif %}
{% endif %}
{{ content }}
{% if errors %}
  <div class="form-item--error-message alert alert-danger alert-sm">
    {{ errors }}
  </div>
{% endif %}
{% if description %}
  <p class="help-block">{{ description }}</p>
{% endif %}
